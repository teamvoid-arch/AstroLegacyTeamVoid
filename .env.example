# Copy to .env (never commit .env). Used only by `npm run vo:generate` on your computer.
# The browser never sees these values.
ELEVENLABS_API_KEY=
# Warm female storyteller voice for VIMO (pick one in your ElevenLabs Voice Library)
ELEVENLABS_VIMO_VOICE_ID=
# Optional: separate voice for kid questions (defaults to VIMO's voice)
ELEVENLABS_KID_VOICE_ID=
# Calm, friendly voice for the machines (era radio filters are added in the browser)
ELEVENLABS_MACHINE_VOICE_ID=
# eleven_multilingual_v2 (default) or another TTS model your plan supports
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Bangla voice needs a model that speaks Bengali (used by `npm run voice -- --lang bn`)
ELEVENLABS_BN_MODEL_ID=eleven_v3

# Google Veo (Gemini API) for the VIMO TV explainer clips: `npm run video`
GEMINI_API_KEY=
# Optional: another Veo model your key can use (default veo-3.0-fast-generate-001)
VEO_MODEL=
